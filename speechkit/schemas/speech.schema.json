{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neural speech exchange 1.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "segments"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "spokenText",
          "path",
          "sha256",
          "samples",
          "sampleRate",
          "durationSeconds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "spokenText": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "samples": {
            "type": "integer",
            "minimum": 1
          },
          "sampleRate": {
            "type": "integer",
            "minimum": 1
          },
          "durationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
